# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env

# ---- LiteLLM proxy ----
# Any strong random strings. LITELLM_MASTER_KEY is the gateway credential.
LITELLM_MASTER_KEY=sk-replace-me
LITELLM_SALT_KEY=sk-replace-me

# Public URL of this proxy. Its HOST becomes the default Akto collection name,
# so keep it stable - a changing hostname creates a new collection each restart.
LITELLM_URL=https://your-gateway.example.com

# ---- Akto connector ----
# From Akto Argus -> Connectors -> Setup Guardrail
DATA_INGESTION_SERVICE_URL=https://<account-id>-guardrails.akto.io
AKTO_API_TOKEN=replace-me

# true  = enforce (violations return HTTP 403 before the LLM is called)
# false = observe only (traffic flows, verdicts logged, still ingested)
SYNC_MODE=true

# Seconds. The connector's documented default of 5 is too low for coding-agent
# payloads: guardrail latency crosses 5s around 200KB and the timeout is
# swallowed as a fail-open, silently dropping the event.
TIMEOUT=30

# ---- AWS Bedrock ----
# Prefer an IAM role / instance profile / IRSA in any real deployment. Static
# keys here are for local development only; temporary STS creds expire in hours.
AWS_REGION_NAME=ap-south-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
# Only needed for temporary STS credentials.
AWS_SESSION_TOKEN=

# ---- Guardrail behaviour with coding agents (see README) ----
# Which slice of the request the Akto guardrail judges.
#   auto      narrow to the newest user turn once messages exceed the threshold
#   true      always narrow to the newest user turn  (recommended for agents)
#   all_user  narrow to all user turns
#   false     send the whole request (upstream behaviour)
VALIDATE_LAST_USER_MESSAGE_ONLY=true
GUARDRAIL_NARROW_THRESHOLD_BYTES=8000

# Strip <system-reminder> harness scaffolding from the judged text.
STRIP_HARNESS_CONTEXT=true

# Remove turns the guardrail already blocked from history before forwarding, so
# a client that resends a rejected message cannot get it to the model.
QUARANTINE_BLOCKED_HISTORY=true

# Diagnostic: logs the exact text handed to the guardrail. Writes prompt content
# to the container log, so keep it off outside debugging.
LOG_VERDICT_TEXT=false
