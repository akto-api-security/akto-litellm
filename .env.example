# Copy to .env and fill in. Never commit .env.

# --- LiteLLM ---
LITELLM_MASTER_KEY=sk-choose-your-own-key
LITELLM_SALT_KEY=sk-salt-random-and-permanent   # encrypts stored creds; CANNOT be rotated
DATABASE_URL=postgresql://llmproxy:dbpassword9090@db:5432/litellm

# --- AWS Bedrock ---
# IAM needs: bedrock:InvokeModel, bedrock:InvokeModelWithResponseStream, bedrock:ApplyGuardrail
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=                              # only for temporary/STS credentials

# Bedrock console -> Guardrails. Use the ID, not the ARN.
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=1

# --- Akto (per Akto's LiteLLM connector docs) ---
LITELLM_URL=http://localhost:4000               # host becomes the Akto collection name
DATA_INGESTION_SERVICE_URL=https://<your-akto-host>
AKTO_API_TOKEN=
SYNC_MODE=true                                  # true = block, false = observe only
TIMEOUT=5

# Judge only the newest user turn, not agent scaffolding. See README "Coding agents".
VALIDATE_LAST_USER_MESSAGE_ONLY=true
